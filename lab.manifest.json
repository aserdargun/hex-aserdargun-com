  "evidencePolicy": {
    "summary": {
      "en": "Kinematic teaching aids and manual inspection. No dynamics, trained policy, measured performance or engineering certification.",
      "tr": "Kinematik eğitim araçları ve elle inceleme. Dinamik, eğitilmiş politika, ölçülmüş performans veya mühendislik onayı yoktur."
    },
    "allowedKinds": [
      "simulated",
      "user-input"
    ]
  },
  "assumptions": [
    {
      "id": "teaching-geometry",
      "title": {
        "en": "Authored teaching geometry",
        "tr": "Kurgulanmış eğitim geometrisi"
      },
      "description": {
        "en": "The Blender-authored GLB is the visual source of truth. Material families and mechanisms are illustrative; no load limit, alloy grade, torque, ratio or controller frequency is certified.",
        "tr": "Blender ile hazırlanmış GLB görsel doğruluk kaynağıdır. Malzeme aileleri ve mekanizmalar temsilidir; yük sınırı, alaşım sınıfı, tork, oran veya kontrolcü frekansı onaylanmaz."
      }
    },
    {
      "id": "kinematic-only",
      "title": {
        "en": "Kinematic teaching motion",
        "tr": "Kinematik eğitim hareketi"
      },
      "description": {
        "en": "Angles, COM/CoP markers and sequences are illustrative. There is no dynamics simulation, inverse-kinematics solver, trained policy or measured robot telemetry.",
        "tr": "Açılar, COM/CoP işaretleri ve diziler temsilidir. Dinamik simülasyonu, ters kinematik çözücüsü, eğitilmiş politika veya ölçülmüş robot telemetrisi yoktur."
      }
    }
  ],
  "evidence": [
    {
      "schemaVersion": "0.1",
      "id": "motion",
      "kind": "simulated",
      "verificationStatus": "not-applicable",
      "label": {
        "en": "Kinematic motion and overlays",
        "tr": "Kinematik hareket ve katmanlar"
      },
      "notes": {
        "en": "Authored motions expose relationships without proving physical stability or performance. Rendered overlays remain observer outputs.",
        "tr": "Kurgulanmış hareketler fiziksel kararlılık veya performans kanıtlamadan ilişkileri gösterir. Görsel katmanlar gözlem çıktısı olarak kalır."
      },
      "assumptionRefs": [
        "teaching-geometry",
        "kinematic-only"
      ]
    },
    {
      "schemaVersion": "0.1",
      "id": "controls",
      "kind": "user-input",
      "verificationStatus": "not-applicable",
      "label": {
        "en": "Manual inspection state",
        "tr": "Elle inceleme durumu"
      },
      "notes": {
        "en": "Mode, joint, angle and exploded stage are learner selections. They do not represent a robot command or a validated engineering configuration.",
        "tr": "Mod, eklem, açı ve ayrıştırma aşaması öğrenen seçimleridir. Robot komutu veya doğrulanmış mühendislik yapılandırması değildir."
      },
      "assumptionRefs": [
        "teaching-geometry",
        "kinematic-only"
      ]
    }
  ],
