{
  "name": "hex-humanoid-engineering-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "tsc -b && vite build && node scripts/verify-artifact.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4186 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "validate:codex": "npm run lint && node scripts/component-catalogue.mjs --check && npm test && npm run model:validate && npm run build && npm run test:e2e && git diff --check",
    "model:build": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --python scripts/build_hex.py",
    "model:render": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background HEX/blender/HEX_Master.blend --python scripts/render_hex.py",
    "model:validate": "node scripts/validate-glb.mjs",
    "model:catalogue": "node scripts/component-catalogue.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "@aserdargun/lab-core": "file:vendor/aserdargun-lab-core-0.2.0-fb38c750c230ff3d.tgz",
    "@aserdargun/lab-ui": "file:vendor/aserdargun-lab-ui-0.2.0-5a573640012a6472.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.7"
  }
}
